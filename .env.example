# ============================================================
# Kaled-Kled — server-only variables (Node/PWA server).
# NEVER prefix these with VITE_ — they must not reach the browser.
# This file holds placeholders only. Real secrets live in the
# server environment / .env.local (git-ignored), never in git.
# ============================================================

# Base URL of the Providence platform API (must end with /api)
PROVIDENCE_API_BASE=https://laprovidencemfondationmnrh.cloud/api

# Sanctum token of a dedicated read-only service user (create it
# on the platform; needs: manage_students + view_reports for the
# proxied endpoints, nothing else for Phase 1 read-only)
PROVIDENCE_API_TOKEN=

# Optional: upstream timeout in ms (default 20000)
PROVIDENCE_TIMEOUT_MS=20000

# Existing app secrets (unchanged, documented in
# DEPLOYMENT_ENVIRONMENT_SETUP.md)
JWT_SECRET=
