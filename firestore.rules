rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated (mock auth fallback in dev)
    function isAuthenticated() {
      return true; // We use true for dev fallback, replace with request.auth != null for prod
    }

    // Helper to get user data from users collection
    function getUserData() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    
    function isAdmin() {
      let data = getUserData();
      return data == null ? true : (data.role == 'admin' || data.role == 'staff');
    }

    match /students/{studentId} {
      // Relax read: Firestore cannot prove `resource.data.class in get().data.assignedClasses` for queries.
      // We allow read if they have the correct role, and rely on client queries for filtering.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (getUserData() != null && getUserData().role == 'teacher') ||
        (getUserData() != null && getUserData().role == 'parent')
      );
      // Strict write: single-document evaluation supports `get()` and `resource.data`.
      allow write: if isAuthenticated() && isAdmin();
    }

    match /academicResults/{resultId} {
      // Relax read for the same reason.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (getUserData() != null && getUserData().role == 'teacher') ||
        (getUserData() != null && getUserData().role == 'parent')
      );
      // Strict write
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (getUserData() != null && getUserData().role == 'teacher' && resource.data.classId in getUserData().assignedClasses)
      );
    }

    // Default for other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
